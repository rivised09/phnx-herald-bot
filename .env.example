# Discord
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Channels & Roles
EVENTS_CHANNEL_ID=
REMINDERS_CHANNEL_ID=
LEADERSHIP_ROLE_ID=


# Frontend
CLIENT_URL=http://localhost:3000
# Must match the web app's DASHBOARD_ACCESS_CODE. The web app forwards it as
# x-dashboard-code on /api/settings; if they differ, settings return 401.
DASHBOARD_ACCESS_CODE=

# Server
PORT=3001
# Shared secret for the /almanac archive API (must match the web app)
ALMANAC_SECRET=

# Roster source (callofstats.com). The bot scrapes it once and writes what it
# reads into Supabase; the site never serves the pages directly.
# Logs in once, then persists tokens to data/ (gitignored) so it does not
# re-authenticate on every scrape.
#
# Several accounts may be listed as parallel comma-separated lists. The source
# rate-limits: it invalidates the session of an account it decides is scraping
# too hard, and the crawler moves to the next account when that happens.
# CALLOFSTATS_USERNAMES / CALLOFSTATS_PASSWORDS work too if you prefer plural
# keys. Never put real credentials in this file - it is committed.
CALLOFSTATS_USERNAME=
CALLOFSTATS_PASSWORD=
# Server to read. Defaults to 973.


CALLOFSTATS_SERVER_ID=973
# Scrape target. Defaults to the server page when left empty.
PLAYER_STATS_SOURCE_URL=

# --- Detail backfill (src/roster/detail.js) ---------------------------------
# Wall-clock budget for one run; work resumes where the last run stopped.
ROSTER_DETAIL_BUDGET_MS=600000
# Gap enforced between request starts, across every concurrent worker. This is
# what keeps the run below the source's rate limit - keep it at 500 or above.
ROSTER_DETAIL_DELAY_MS=1500
ROSTER_DETAIL_CONCURRENCY=1
# Accounts one refusal may cycle through before giving up, so a long account
# list cannot turn a single refusal into a dozen browser logins.
ROSTER_DETAIL_MAX_ROTATIONS=3
# How long to stay quiet after a refusal before trying again.
ROSTER_DETAIL_COOLDOWN_MS=1800000
# 'latest' collects player detail for the newest date only (about 1,000
# requests for a month of history). 'all' collects it for every stored date
# (about 9,450). Server and alliance detail follow ROSTER_HISTORY below.
ROSTER_DETAIL_PLAYERS=all
# How old the newest date's detail may get before it is collected again.
ROSTER_DETAIL_REFRESH_MS=21600000
# Set to 1 to switch the detail pass off entirely.
ROSTER_DETAIL_DISABLED=

# --- Scope -------------------------------------------------------------------
# What a run is allowed to work through (src/roster/scope.js).
#
# Left unset - the deployed default - the sync and the detail pass only keep
# the newest date current. Set to 1 to also scrape and inject every older date
# the source still offers; that is what `npm run history` does, locally.
ROSTER_HISTORY=1
# Dates filled in per history run of the roster sync.
ROSTER_BACKFILL_BATCH=3
CALLOFSTATS_USERNAME="markbenson.matanguihan@dwcc.edu.ph,capstone262@gmail.com"
CALLOFSTATS_PASSWORD="markbenson.matanguihan@dwcc.edu.ph,capstone262@gmail.com"

# --- Roster snapshots -------------------------------------------------------
# ROSTER_SYNC_CRON=23 * * * *
# ROSTER_SYNC_DISABLED=

# --- JSON export (scripts/export.js) ----------------------------------------
# The site can read the roster as flat JSON files instead of querying Postgres.
# `npm run export -- --out <dir>` writes them to a directory; with the values
# below it uploads them to Cloudflare R2 instead.
#
# R2 speaks the S3 API, so these are an R2 API token ("Object Read & Write",
# scoped to the bucket) - not the Cloudflare global API key.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Key prefix inside the bucket. Defaults to "roster".
R2_PREFIX=roster
# Public base URL the bucket is served from (custom domain or the r2.dev
# subdomain), without the prefix. The web app reads `${R2_PUBLIC_BASE_URL}/roster`.
R2_PUBLIC_BASE_URL=

# --- DragonStats browser -----------------------------------------------------
# Chromium cannot start as root with its sandbox on, which is how container
# hosts run it. It is disabled automatically when the bot runs as root on
# Linux; set this to 1 to force it off elsewhere, or 0 to force it on.
# DRAGONSTATS_NO_SANDBOX=
#
# Interactive Google sign-in needs a display the bot can open a window on.
# Windows and macOS are treated as desktops; on Linux, DISPLAY or
# WAYLAND_DISPLAY is used (and the X socket is checked). Set this to 0 on a
# server whose virtual display nobody is watching, so the job fails with an
# explanation instead of waiting for a prompt that cannot be answered.
# DRAGONSTATS_INTERACTIVE_LOGIN=
