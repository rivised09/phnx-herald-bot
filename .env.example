# Frontend
CLIENT_URL=http://localhost:3000
# Must match the web app's DASHBOARD_ACCESS_CODE. The web app forwards it as
# x-dashboard-code on /api/settings; if they differ, settings return 401.
DASHBOARD_ACCESS_CODE=

# Server
PORT=3001
# Shared secret for the /almanac archive API (must match the web app)
ALMANAC_SECRET=

# Public home page roster, v1 (scrape of callofstats.com)
# Logs in once, then persists tokens to data/ (gitignored) so it does not
# re-authenticate on every scrape.
#
# Several accounts may be listed as parallel comma-separated lists. The source
# rate-limits: it invalidates the session of an account it decides is scraping
# too hard, and the crawler moves to the next account when that happens.
# CALLOFSTATS_USERNAMES / CALLOFSTATS_PASSWORDS work too if you prefer plural
# keys. Never put real credentials in this file - it is committed.
CALLOFSTATS_USERNAME="baklangtoh1109@gmail.com,markbensonmatanguihan@gmail.com,bensonofficial0121@gmail.com,20-38704@g.batstate-u.edu.ph,markbens12,venusahml,bloodyviii0121+shopping,mark.up1109,flarewavecreations,riv.ised09,markbensonsuzara6,junmyeon0121"
CALLOFSTATS_PASSWORD="baklangtoh1109@gmail.com,markbensonmatanguihan@gmail.com,bensonofficial0121@gmail.com,20-38704@g.batstate-u.edu.ph,markbens12,venusahml,bloodyviii0121+shopping,mark.up1109,flarewavecreations,riv.ised09,markbensonsuzara6,junmyeon0121"
# Server to read. Defaults to 973.
CALLOFSTATS_SERVER_ID=973
# Scrape target. Defaults to the server page when left empty.
PLAYER_STATS_SOURCE_URL=

# --- Detail backfill (src/roster/detail.js) ---------------------------------
# Wall-clock budget for one run; work resumes where the last run stopped.
ROSTER_DETAIL_BUDGET_MS=600000
# Gap enforced between request starts, across every concurrent worker. This is
# what keeps the run below the source's rate limit - keep it at 500 or above.
ROSTER_DETAIL_DELAY_MS=1500
ROSTER_DETAIL_CONCURRENCY=1
# Accounts one refusal may cycle through before giving up, so a long account
# list cannot turn a single refusal into a dozen browser logins.
ROSTER_DETAIL_MAX_ROTATIONS=3
# How long to stay quiet after a refusal before trying again.
ROSTER_DETAIL_COOLDOWN_MS=1800000
# 'latest' collects player detail for the newest date only (about 1,000
# requests for a month of history). 'all' collects it for every stored date
# (about 9,450). Server and alliance detail always covers every date.
ROSTER_DETAIL_PLAYERS=latest
# How old the newest date's detail may get before it is collected again.
ROSTER_DETAIL_REFRESH_MS=21600000
# Set to 1 to switch the detail pass off entirely.
ROSTER_DETAIL_DISABLED=

