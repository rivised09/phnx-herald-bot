generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Event {
  id               String   @id @default(uuid())
  guildId          String   @map("guild_id") @db.VarChar(40)
  title            String
  description      String?
  startTime        DateTime @map("start_time")
  endTime          DateTime @map("end_time")
  location         String?
  entityType       String   @default("EXTERNAL") @map("entity_type")
  channelId        String?  @map("channel_id")
  status           String   @default("SCHEDULED") @db.VarChar(20)

  discordMessageId String?  @map("discord_message_id") @db.VarChar(40)
  discordEventId   String?  @map("discord_event_id") @db.VarChar(40)

  pingOneHour      Boolean  @default(false) @map("ping_one_hour")
  pingThirtyMin    Boolean  @default(false) @map("ping_thirty_min")
  pingTenMin       Boolean  @default(false) @map("ping_ten_min")
  pingSevenHours   Boolean  @default(false) @map("ping_seven_hours")
  pingStarted      Boolean  @default(false) @map("ping_started")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("events")

  @@index([status])
  @@index([startTime])
  @@index([guildId])
}

model DiscordChannel {
  id        String   @id @db.VarChar(40)
  guildId   String   @map("guild_id") @db.VarChar(40)
  name      String
  type      String   @db.VarChar(20)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("discord_channels")

  @@index([guildId])
  @@index([type])
}

model Task {
  id          String      @id @default(uuid())
  guildId     String      @map("guild_id") @db.VarChar(40)
  taskNumber  Int         @default(0) @map("task_number")
  title       String
  description String?
  createdBy   String?     @map("created_by") @db.VarChar(40)
  assignedTo  String?     @map("assigned_to") @db.VarChar(40)
  status      String      @default("OPEN") @map("status") @db.VarChar(20)
  progress    Int         @default(0)
  priority    String      @default("NORMAL") @db.VarChar(10)
  dueDate     DateTime?   @map("due_date")
  completedAt DateTime?   @map("completed_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  updates TaskUpdate[]

  @@map("tasks")

  @@index([guildId])
  @@index([status])
  @@index([assignedTo])
  @@index([taskNumber])
}

model TaskUpdate {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  userId    String   @map("user_id") @db.VarChar(40)
  progress  Int      @default(0)
  status    String   @default("OPEN") @db.VarChar(20)
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_updates")

  @@index([taskId])
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}