{
  "name": "phoenix-herald-bot",
  "version": "1.0.0",
  "description": "Phoenix Herald - Discord event bot and API",
  "main": "src/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "npx prisma migrate deploy && npx prisma migrate deploy --schema prisma-roster/schema.prisma && node src/index.js",
    "dev": "node src/index.js",
    "deploy:commands": "node src/bot/deploy-commands.js",
    "migrate": "prisma migrate dev && prisma migrate dev --schema prisma-roster/schema.prisma",
    "migrate:deploy": "prisma migrate deploy && prisma migrate deploy --schema prisma-roster/schema.prisma",
    "install:browsers": "playwright install --with-deps chromium",
    "test": "node test/roster.test.js",
    "history": "node scripts/history.js",
    "export": "node scripts/export.js",
    "conform": "node scripts/conform.js",
    "dragon:login": "node scripts/dragon-login.js",
    "dragon:probe": "node scripts/dragon-probe.js",
    "dragon:frames": "node scripts/dragon-frames.js",
    "dragon:map": "node scripts/dragon-map.js",
    "scrape": "node scripts/scrape.js",
    "callofstats:scrape": "node scripts/callofstats-scrape.js",
    "enrich": "node scripts/enrich.js",
    "clean:albums": "node scripts/clean-top-level-albums.js",
    "debug:player": "node scripts/debug-player.js",    "sync": "node scripts/history.js --latest",
    "postinstall": "prisma generate && prisma generate --schema prisma-roster/schema.prisma"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@prisma/client": "^6.7.0",
    "cheerio": "^1.2.0",
    "convex": "^1.48.0",
    "cors": "^2.8.5",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "playwright": "^1.63.0",
    "prisma": "^6.7.0"
  }
}
